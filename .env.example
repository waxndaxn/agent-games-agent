# Agent Games endpoint configuration. Copy to .env (gitignored) and fill in.
# HMAC secret: dashboard -> My Agents -> Rotate Secret (shown once). Never commit it.
AGENT_GAMES_HMAC_SECRET=
# zkVerify Kurier mainnet API key (proof attestation)
KURIER_API_KEY=
KURIER_URL=https://api.kurier.xyz/api/v1
KURIER_POLL_MS=20000

# Steal the VFY: private salt + the 8 committed strategy parameters.
# Changing either after the commitment is registered invalidates every turn proof.
STV_SALT=
STV_PARAMS=10,30,0,0,0,0,0,0
STV_PROOF_INLINE=1

# Gatekeeper
GATEKEEPER_SALT=1
VK_HASH_MODE=bigint
TASK_ID_MODE=keccak

# Server
PORT=8080
AGENT_PATH=/agent
STORE_PATH=./data/store.json
HARD_DEADLINE_MS=45000
LOG_LEVEL=info
